{
  "name": "goapp-frontflow",
  "version": "0.1.0",
  "private": true,
  "description": "GoApp FrontFlow — desktop control plane for AI-assisted frontend delivery",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run dev -w @frontflow/desktop",
    "build": "npm run build -w @frontflow/desktop",
    "test:e2e": "npm run build && playwright test -c tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
