{
  "testCases": [
    {
      "id": "TC-BA-ORDER-001-01",
      "requirementIds": ["BA-ORDER-001"],
      "title": "Customer cancels a pending order",
      "preconditions": [{ "description": "A PENDING order owned by the customer", "setup": "mock getOrder → status PENDING; mock cancelOrder → 200 CANCELLED" }],
      "steps": [
        { "action": "Open the Cancel Order Modal", "uiFlowNodeId": "SCR-cancel-order-modal", "apiOperationId": "getOrder" },
        { "action": "Confirm cancellation", "uiFlowNodeId": "SCR-cancel-order-modal", "apiOperationId": "cancelOrder" }
      ],
      "expectedOutcomes": [{ "description": "The order status becomes CANCELLED", "kind": "ui" }],
      "testData": [{ "name": "orderId", "description": "A pending order", "example": "ord_1" }],
      "uiFlowNodeIds": ["SCR-cancel-order-modal"],
      "apiOperationIds": ["getOrder", "cancelOrder"],
      "level": "e2e"
    },
    {
      "id": "TC-BA-ORDER-001-02",
      "requirementIds": ["BA-ORDER-001"],
      "title": "Order that can no longer be cancelled",
      "preconditions": [{ "description": "A SHIPPED order", "setup": "mock cancelOrder → 409 ORDER_CANNOT_BE_CANCELLED" }],
      "steps": [{ "action": "Confirm cancellation", "uiFlowNodeId": "SCR-cancel-order-modal", "apiOperationId": "cancelOrder" }],
      "expectedOutcomes": [{ "description": "ORDER_CANNOT_BE_CANCELLED is shown and the order is unchanged", "kind": "ui" }],
      "testData": [],
      "uiFlowNodeIds": ["SCR-cancel-order-modal"],
      "apiOperationIds": ["cancelOrder"],
      "level": "integration"
    },
    {
      "id": "TC-BA-ORDER-002-01",
      "requirementIds": ["BA-ORDER-002"],
      "title": "Order that does not exist",
      "preconditions": [{ "description": "No order with this id", "setup": "mock getOrder → 404 ORDER_NOT_FOUND" }],
      "steps": [{ "action": "Open the order", "uiFlowNodeId": "SCR-cancel-order-modal", "apiOperationId": "getOrder" }],
      "expectedOutcomes": [{ "description": "ORDER_NOT_FOUND is shown", "kind": "ui" }],
      "testData": [],
      "uiFlowNodeIds": ["SCR-cancel-order-modal"],
      "apiOperationIds": ["getOrder"],
      "level": "integration"
    }
  ],
  "testabilityGaps": []
}
